<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ==================== HEADER ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/arrow_regresar"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txt_afinador_header"
                android:layout_width="166dp"
                android:layout_height="48dp"
                android:background="@drawable/gradiente_afinador"
                android:gravity="center"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:text="Afinador"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/mic_recording"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- Barra de sonido - SUBIDA 8px -->
        <ProgressBar
            android:id="@+id/barra_sonido"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="-8dp"
            android:layout_marginBottom="16dp"
            android:progress="0"
            android:max="100"
            android:progressTint="#f911eb"
            android:progressBackgroundTint="#333333" />

        <!-- Notas musicales -->
        <TextView
            android:id="@+id/txt_notas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="C   D   E   F   G   A   B"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Cuadros de notas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/cuadro_nota_baja"
                android:layout_width="55dp"
                android:layout_height="45dp"
                android:background="@drawable/cuadro_nota"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:text="G"
                android:layout_marginEnd="20dp" />

            <LinearLayout
                android:id="@+id/cuadro_nota_actual"
                android:layout_width="75dp"
                android:layout_height="70dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/cuadro_nota"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <TextView
                    android:id="@+id/txt_nota_clasica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sol"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/txt_nota_moderna"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />
            </LinearLayout>

            <TextView
                android:id="@+id/cuadro_nota_alta"
                android:layout_width="55dp"
                android:layout_height="45dp"
                android:background="@drawable/cuadro_nota"
                android:gravity="center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:text="A"
                android:layout_marginStart="20dp" />

        </LinearLayout>

        <!-- Mensaje de ruido -->
        <TextView
            android:id="@+id/txt_ruido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Semicírculo - SUBIDO 20px -->
        <vhuguito.musictoolboxapp.SemicircleView
            android:id="@+id/semicirculo_afinacion"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="10dp" />

        <!-- Frecuencia - SUBIDA 6px -->
        <TextView
            android:id="@+id/txt_frecuencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frecuencia: 0 Hz"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginTop="-6dp"
            android:layout_marginBottom="16dp" />

        <!-- Botones inferiores - SUBIDOS 10px -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="-10dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="30dp">

                <ImageButton
                    android:id="@+id/btn_star"
                    android:layout_width="63dp"
                    android:layout_height="63dp"
                    android:src="@drawable/star"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txt_sin_anuncios"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:text="Sin anuncios"
                    android:textColor="#fdd53b"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_perfil"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:src="@drawable/folder_profile"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="30dp">

                <ImageButton
                    android:id="@+id/btn_diamante"
                    android:layout_width="71dp"
                    android:layout_height="71dp"
                    android:src="@drawable/diamante"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txt_premium"
                    android:layout_width="77dp"
                    android:layout_height="wrap_content"
                    android:text="Premium"
                    android:textColor="#03fdee"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </LinearLayout>

        <!-- BANNER PUBLICITARIO -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            adUnitId="ca-app-pub-2355410845517735/4839382412"
            adSize="BANNER" />

    </LinearLayout>
</ScrollView>