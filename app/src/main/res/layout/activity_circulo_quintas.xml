<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main_gradient"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:src="@drawable/arrow_regresar"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="213dp"
            android:layout_height="62dp"
            android:gravity="center"
            android:text="Círculo de Quintas"
            android:textColor="#000000"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/boton_texto_circulo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Vista personalizada del círculo de quintas -->
    <com.vhuguito.musicboxdos.CirculoQuintasView
        android:id="@+id/circulo_quintas_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botón Premium -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_diamante"
                android:layout_width="71dp"
                android:layout_height="71dp"
                android:src="@drawable/diamante"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/txt_premium"
                android:layout_width="77dp"
                android:layout_height="wrap_content"
                android:text="Premium"
                android:textColor="#03fdee"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- BANNER -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-2355410845517735/4839382412" />

    <ImageView
        android:id="@+id/imgPromocional"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/vhuguito_promo"
        android:visibility="gone"
        android:contentDescription="Imagen promocional VHuguito" />

</LinearLayout>